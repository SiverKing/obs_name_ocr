{
  "interval_ms": 300,
  "host": "0.0.0.0",
  "port": 8766,
  "capture": {
    "source": "obs_websocket",
    "monitor": 1,
    "left": 0,
    "top": 0,
    "width": 2560,
    "height": 1440,
    "obs_websocket": {
      "url": "ws://127.0.0.1:4455",
      "password": "",
      "source_name": "窗口采集",
      "source_uuid": "0bff0c8b-4869-478a-ad97-f8f5c6e23568",
