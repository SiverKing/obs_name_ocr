    "fuzzy_threshold": 0.88,
    "fuzzy_min_length": 4
  },
  "ocr_output": {
    "enabled": false
  },
  "ocr": {
    "backend": "tensorrt_fp16",
    "use_cuda": true,
    "use_dml": false,
    "use_cls": false,
    "return_word_box": false,
    "reload_files_interval_ms": 2000,
    "log_performance": true,
    "log_performance_interval_ms": 3000
  },
  "overlay": {
    "stroke_color": "#90ff60",
    "color_mode": "by_target",
    "color_palette": [
      "#1f77b4",
      "#ff7f0e",
      "#2ca02c",
      "#d62728",
      "#9467bd",
      "#8c564b",
      "#e377c2",
      "#17becf"
